<Window x:Class="ScriptsManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScriptsManager.App.ViewModels"
        xmlns:core="clr-namespace:ScriptsManager.Core.Manifests;assembly=ScriptsManager.Core"
        xmlns:infra="clr-namespace:ScriptsManager.App.Infrastructure"
        xmlns:views="clr-namespace:ScriptsManager.App.Views"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:md="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        Title="Scripts Manager" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Activated="Window_Activated">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Меню запуска в списке «Запуски» (в ресурсах: обработчики в Setter стиля WPF не подключает). -->
        <ContextMenu x:Key="RunMenu" x:Shared="False">
            <MenuItem Header="Открыть результат" Click="RunMenu_Open" FontWeight="SemiBold" />
            <MenuItem Header="Переименовать…" Click="RunMenu_Rename" />
            <MenuItem Header="Удалить результат" Click="RunMenu_Delete" />
        </ContextMenu>

        <!-- Значок языка скрипта в дереве (сетка 16×16): T-SQL — значок Management Studio, PL/pgSQL — значок pgAdmin,
             PowerShell — плашка с приглашением, Python — сине-жёлтый знак. -->
        <Style x:Key="RunnerIcon" TargetType="ContentControl">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Content" Value="{Binding}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Runner}" Value="{x:Static core:RunnerKind.TSql}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <Image Source="Assets/ssms.png" RenderOptions.BitmapScalingMode="HighQuality" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Runner}" Value="{x:Static core:RunnerKind.PlPgSql}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <Image Source="Assets/pgadmin.png" RenderOptions.BitmapScalingMode="HighQuality" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Runner}" Value="{x:Static core:RunnerKind.PowerShell}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <Viewbox>
                                    <Canvas Width="16" Height="16">
                                        <Path Fill="#2671BE" Data="M4,2 L16,2 L12,14 L0,14 Z" />
                                        <Path Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                              Data="M4.2,5 L7.8,8 L3.2,11 M7.5,11.2 L10.5,11.2" />
                                    </Canvas>
                                </Viewbox>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Runner}" Value="{x:Static core:RunnerKind.Python}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <Viewbox>
                                    <Canvas Width="16" Height="16">
                                        <Rectangle Canvas.Left="1" Canvas.Top="1" Width="9.5" Height="9.5" RadiusX="2.5" RadiusY="2.5" Fill="#3776AB" />
                                        <Rectangle Canvas.Left="5.5" Canvas.Top="5.5" Width="9.5" Height="9.5" RadiusX="2.5" RadiusY="2.5" Fill="#FFD43B"
                                                   Stroke="White" StrokeThickness="0.8" />
                                        <Ellipse Canvas.Left="2.8" Canvas.Top="2.8" Width="1.8" Height="1.8" Fill="White" />
                                        <Ellipse Canvas.Left="11.4" Canvas.Top="11.4" Width="1.8" Height="1.8" Fill="#3776AB" />
                                    </Canvas>
                                </Viewbox>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnmanaged}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Значок состояния запуска (в Tag — RunState); формы разные, чтобы не путать по цвету:
             выполняется — стрелки, выполнен — галочка, ошибка — крестик, остановлен — квадрат. -->
        <Style x:Key="RunDot" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="&#xE71A;" />
            <Setter Property="Foreground" Value="#757575" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:RunState.Running}">
                    <Setter Property="Text" Value="&#xE895;" />
                    <Setter Property="Foreground" Value="#1565C0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:RunState.Succeeded}">
                    <Setter Property="Text" Value="&#xE73E;" />
                    <Setter Property="Foreground" Value="#2E7D32" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:RunState.Failed}">
                    <Setter Property="Text" Value="&#xE711;" />
                    <Setter Property="Foreground" Value="#C62828" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CodeEditor" TargetType="avalon:TextEditor">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ShowLineNumbers" Value="True" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <DataTemplate DataType="{x:Type vm:ScriptDetailsViewModel}">
            <DockPanel Margin="12,8,8,8">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" Foreground="#666" Margin="0,2,0,0"
                               Visibility="{Binding Summary, Converter={StaticResource VisibleIfAny}}" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding Description, Converter={StaticResource VisibleIfAny}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Изменить…" Command="{Binding DataContext.EditScriptCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Открыть скрипт" Command="{Binding OpenScriptCommand}" />
                        <Button Content="Открыть манифест" Command="{Binding OpenManifestCommand}" />
                        <Button Content="Показать в папке" Command="{Binding ShowInFolderCommand}" />
                        <Button Content="Удалить…" Margin="12,0,0,0" ToolTip="Скрипт, манифест и пресеты — в корзину"
                                Command="{Binding DataContext.DeleteScriptCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>

                    <Border Margin="0,10,0,0" Padding="8,6" CornerRadius="3" BorderThickness="1"
                            Visibility="{Binding HasIssues, Converter={StaticResource VisibleIfAny}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFF8E1" />
                                <Setter Property="BorderBrush" Value="#F0C36D" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                        <Setter Property="Background" Value="#FDECEA" />
                                        <Setter Property="BorderBrush" Value="#E57373" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Замечания к манифесту" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                <Setter Property="Text" Value="Ошибки в манифесте — скрипт нельзя запустить" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <TextBlock DockPanel.Dock="Left" Margin="0,1,6,0" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                                        <Setter Property="Text" Value="&#xE7BA;" />
                                                        <Setter Property="Foreground" Value="#B26A00" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                <Setter Property="Text" Value="&#xE783;" />
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TabControl Margin="0,10,0,0" SelectedIndex="{Binding SelectedTabIndex}">
                    <TabItem Header="Запуск">
                        <Grid>
                            <DockPanel Visibility="{Binding Form, Converter={StaticResource VisibleIfAny}}">
                                <Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8">
                                    <DockPanel>
                                        <Button Content="Запустить" Command="{Binding RunCommand}" FontWeight="SemiBold"
                                                Padding="18,4" />
                                        <TextBlock Text="{Binding Form.Message}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   TextWrapping="Wrap" Foreground="#555" />
                                    </DockPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <views:ParameterFormView DataContext="{Binding Form}" Margin="8,10,8,8" />
                                </ScrollViewer>
                            </DockPanel>
                            <TextBlock Text="{Binding NoFormHint}" Foreground="#888" Margin="8"
                                       Visibility="{Binding Form, Converter={StaticResource VisibleIfNone}}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Результат">
                        <DockPanel>
                        <!-- Скрипт запускали несколько раз (например, на разных серверах) — какой запуск показать. -->
                        <DockPanel DockPanel.Dock="Top" Margin="6,6,6,0"
                                   Visibility="{Binding HasSeveralRuns, Converter={StaticResource VisibleIfAny}}">
                            <TextBlock Text="Запуск:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding ScriptRuns}" SelectedItem="{Binding CurrentRun}" DisplayMemberPath="Caption"
                                      MaxWidth="500" HorizontalAlignment="Left" MinWidth="300" />
                        </DockPanel>
                        <Grid>
                            <TextBlock Text="Скрипт в этом сеансе ещё не запускали" Foreground="#888" Margin="8"
                                       Visibility="{Binding CurrentRun, Converter={StaticResource VisibleIfNone}}" />
                            <DockPanel DataContext="{Binding CurrentRun}"
                                       Visibility="{Binding Converter={StaticResource VisibleIfAny}}">
                                <DockPanel DockPanel.Dock="Top" Margin="6,6,6,4">
                                    <Button DockPanel.Dock="Right" Content="Удалить результат" Margin="0" Click="RunMenu_Delete"
                                            ToolTip="Убрать этот запуск вместе с результатами" />
                                    <Button DockPanel.Dock="Right" Content="Переименовать…" Click="RunMenu_Rename"
                                            ToolTip="Своё название запуска — чтобы отличать результаты" />
                                    <Button DockPanel.Dock="Right" Content="Остановить" Command="{Binding StopCommand}" />
                                    <!-- Новый запуск с теми же параметрами; этот результат остаётся. -->
                                    <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                            ToolTip="Запустить ещё раз с этими же параметрами"
                                            Command="{Binding DataContext.RerunCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.CanRerun, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource VisibleIfAny}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <TabControl ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}">
                                    <TabControl.ItemContainerStyle>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Header" Value="{Binding Title}" />
                                        </Style>
                                    </TabControl.ItemContainerStyle>
                                    <TabControl.Resources>
                                        <DataTemplate DataType="{x:Type vm:MessagesTab}">
                                            <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     infra:LogBox.Run="{Binding Run}" />
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:ResultSetViewModel}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,4,2,4">
                                                    <Button Content="Сохранить…" Command="{Binding ExportCommand}" ToolTip="В Excel (xlsx) или CSV" />
                                                    <Button Content="Копировать как ▾" Click="CopyAsButton_Click"
                                                            ToolTip="Выделенное (или всю таблицу) — в разметке Jira, Markdown, как SELECT…" />
                                                    <TextBlock Text="Щелчок по заголовку строки или столбца — выделить (Ctrl, Shift — несколько); правый щелчок по заголовку столбца — сортировка; Ctrl+C — скопировать, Ctrl+Shift+C — с заголовками; двойной щелчок — значение целиком"
                                                               Foreground="#888" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <DataGrid ItemsSource="{Binding View}" IsReadOnly="True" AutoGenerateColumns="True"
                                                          AutoGeneratingColumn="ResultGrid_AutoGeneratingColumn"
                                                          MouseDoubleClick="ResultGrid_MouseDoubleClick"
                                                          PreviewKeyDown="ResultGrid_PreviewKeyDown"
                                                          SelectionUnit="CellOrRowHeader" CanUserSortColumns="False"
                                                          HeadersVisibility="All" GridLinesVisibility="All"
                                                          HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"
                                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                                          FontFamily="Consolas" FontSize="12">
                                                    <DataGrid.ColumnHeaderStyle>
                                                        <Style TargetType="DataGridColumnHeader">
                                                            <EventSetter Event="Click" Handler="ResultColumnHeader_Click" />
                                                            <EventSetter Event="ContextMenuOpening" Handler="ResultColumnHeader_ContextMenuOpening" />
                                                            <Setter Property="Padding" Value="4,2,8,2" />
                                                        </Style>
                                                    </DataGrid.ColumnHeaderStyle>
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Копировать" InputGestureText="Ctrl+C" Tag="copy" Click="ResultGridAction_Click" />
                                                            <MenuItem Header="Копировать с заголовками" InputGestureText="Ctrl+Shift+C" Tag="copy-headers" Click="ResultGridAction_Click" />
                                                            <Separator />
                                                            <MenuItem Header="Копировать как" SubmenuOpened="CopyAsMenu_SubmenuOpened">
                                                                <Separator />
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                </DataGrid>
                                            </DockPanel>
                                        </DataTemplate>
                                    </TabControl.Resources>
                                </TabControl>
                            </DockPanel>
                        </Grid>
                        </DockPanel>
                    </TabItem>
                    <!-- Файлы, которые скрипт пишет в OUTPUT_DIR: список слева, содержимое выбранного справа. -->
                    <TabItem Header="Вывод" Visibility="{Binding Output, Converter={StaticResource VisibleIfAny}}">
                        <DockPanel DataContext="{Binding Output}">
                            <DockPanel DockPanel.Dock="Top" Margin="6,6,6,4">
                                <Button Content="Обновить" Command="{Binding RefreshCommand}" />
                                <Button Content="Открыть папку" Command="{Binding OpenFolderCommand}" />
                                <Button Content="Открыть файл" Command="{Binding OpenFileCommand}" />
                                <Button Content="Удалить" Command="{Binding DeleteFileCommand}" />
                                <TextBlock Text="{Binding Folder, StringFormat=OUTPUT_DIR: {0}}" Foreground="#888" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="6,0,0,0" ToolTip="{Binding Folder}" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" MinWidth="150" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                         MouseDoubleClick="OutputFile_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                <TextBlock Foreground="#888" FontSize="11">
                                                    <Run Text="{Binding ModifiedText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Foreground="#888" Margin="8" TextWrapping="Wrap" IsHitTestVisible="False"
                                           Text="Файлов нет. Скрипт пишет сюда через переменную окружения OUTPUT_DIR — например, логи"
                                           Visibility="{Binding Files, Converter={StaticResource VisibleIfNone}}" />
                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                                <avalon:TextEditor Grid.Column="2" Style="{StaticResource CodeEditor}" infra:CodeViewer.Text="{Binding Content}" />
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Описание" Visibility="{Binding ExtendedDescription, Converter={StaticResource VisibleIfAny}}">
                        <md:MarkdownViewer Markdown="{Binding ExtendedDescription}" Pipeline="{x:Static infra:MarkdownView.Pipeline}" />
                    </TabItem>
                    <TabItem Header="Скрипт">
                        <Grid>
                            <avalon:TextEditor Style="{StaticResource CodeEditor}"
                                               infra:CodeViewer.Syntax="{Binding Syntax}"
                                               infra:CodeViewer.Text="{Binding ScriptText}" />
                            <TextBlock Text="Файл скрипта не найден" Foreground="#888" Margin="8"
                                       Visibility="{Binding ScriptText, Converter={StaticResource VisibleIfNone}}" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4" LastChildFill="False">
            <Button Content="Обновить (F5)" Command="{Binding RefreshCommand}" />
            <Button Content="Добавить скрипт…" Command="{Binding AddScriptCommand}"
                    ToolTip="В папку выбранного узла. Файл скрипта можно перетащить в окно" />
            <Button Content="Настройки" Command="{Binding OpenSettingsCommand}" />
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" />
                    <TextBlock Text="Поиск по названию и тегам" Foreground="#999" Margin="7,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource VisibleIfNone}}" />
                </Grid>

                <!-- Теги: отмеченные сужают список — остаются скрипты со всеми отмеченными тегами. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding HasTags, Converter={StaticResource VisibleIfAny}}">
                    <Button DockPanel.Dock="Right" Content="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="5,3" Margin="4,0,0,0"
                            VerticalAlignment="Top" Command="{Binding ClearTagsCommand}" ToolTip="Снять все теги" />
                    <ItemsControl ItemsSource="{Binding TagFilters}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsChecked}" Style="{StaticResource TagToggle}"
                                              ToolTip="Показывать только скрипты с этим тегом (вместе с другими отмеченными)" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- Дерево и список запусков делят высоту; граница между ними перетаскивается. -->
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="RunsRow" Height="0" />
                </Grid.RowDefinitions>
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="Transparent"
                              Visibility="{Binding HasRuns, Converter={StaticResource VisibleIfAny}}" />
                <!-- Запуски сеанса: щелчок — открыть результат; жирным — завершённые, которые ещё не смотрели. -->
                <DockPanel Grid.Row="2" Visibility="{Binding HasRuns, Converter={StaticResource VisibleIfAny}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
                        <Button DockPanel.Dock="Right" Content="Убрать завершённые" Command="{Binding RemoveFinishedRunsCommand}"
                                Margin="0" Padding="6,1" FontSize="11" ToolTip="Убрать из списка завершённые запуски вместе с их результатами" />
                        <TextBlock Text="{Binding RunsHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Runs.All}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="RunsList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="ContextMenu" Value="{StaticResource RunMenu}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RunViewModel}">
                                <DockPanel Margin="0,1" ToolTip="{Binding StatusText}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource RunDot}" Tag="{Binding State}" Margin="0,0,6,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSeen}" Value="False" />
                                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Foreground="#888" FontSize="11" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Details, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Elapsed, Mode=OneWay, StringFormat=hh\\:mm\\:ss}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Grid Grid.Row="0">
                    <TreeView ItemsSource="{Binding Nodes}" SelectedItemChanged="Tree_SelectedItemChanged">
                        <TreeView.Resources>
                            <!-- Команды берутся у владельца узла: ContextMenu не видит DataContext окна. -->
                            <ContextMenu x:Key="RootMenu" x:Shared="False">
                                <MenuItem Header="Добавить скрипт…" Command="{Binding Owner.AddScriptCommand}" CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Получить изменения с сервера (git pull)" Command="{Binding Owner.PullCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Опубликовать…" Command="{Binding Owner.PublishCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Проверить сервер (git fetch)" Command="{Binding Owner.FetchCommand}" />
                            </ContextMenu>
                            <ContextMenu x:Key="FolderMenu" x:Shared="False">
                                <MenuItem Header="Добавить скрипт…" Command="{Binding Owner.AddScriptCommand}" CommandParameter="{Binding}" />
                            </ContextMenu>
                            <ContextMenu x:Key="ScriptMenu" x:Shared="False">
                                <MenuItem Header="Изменить…" Command="{Binding Owner.EditScriptCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Копировать в" ItemsSource="{Binding CopyTargets}"
                                          Visibility="{Binding CanCopy, Converter={StaticResource VisibleIfAny}}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Command" Value="{Binding Script.Owner.CopyToCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Удалить…" Command="{Binding Owner.DeleteScriptCommand}" CommandParameter="{Binding}" />
                            </ContextMenu>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                <Setter Property="Padding" Value="1,2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Root">
                                        <Setter Property="ContextMenu" Value="{StaticResource FolderMenu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                        <Setter Property="ContextMenu" Value="{StaticResource FolderMenu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGitRepo}" Value="True">
                                        <Setter Property="ContextMenu" Value="{StaticResource RootMenu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Script">
                                        <Setter Property="ContextMenu" Value="{StaticResource ScriptMenu}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Margin="0,0,5,0" Foreground="#5C6BC0"
                                               Visibility="{Binding Runner, Converter={StaticResource VisibleIfNone}}" />
                                    <ContentControl Style="{StaticResource RunnerIcon}" Margin="0,0,5,0" ToolTip="{Binding RunnerName}"
                                                    Visibility="{Binding Runner, Converter={StaticResource VisibleIfAny}}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Root">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUnmanaged}" Value="True">
                                                        <Setter Property="Foreground" Value="#888" />
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource RunDot}" Tag="{Binding RunMark}" Margin="6,0,0,0" ToolTip="{Binding RunMarkText}"
                                               Visibility="{Binding RunMark, Converter={StaticResource VisibleIfAny}}" />
                                    <TextBlock Text="&#xE783;" Style="{StaticResource IconText}" Margin="6,0,0,0" Foreground="#C62828"
                                               Visibility="{Binding HasErrors, Converter={StaticResource VisibleIfAny}}" />
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Margin="6,0,0,0" Foreground="#B26A00"
                                               Visibility="{Binding HasWarnings, Converter={StaticResource VisibleIfAny}}" />
                                    <TextBlock Text="{Binding GitMark}" Margin="6,0,0,0" FontWeight="Bold" VerticalAlignment="Center"
                                               Visibility="{Binding GitMark, Converter={StaticResource VisibleIfAny}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E68A00" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GitMark}" Value="+">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GitMark}" Value="!">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding GitSummary}" Margin="8,0,0,0" FontSize="11" Foreground="#888" VerticalAlignment="Center"
                                               Visibility="{Binding GitSummary, Converter={StaticResource VisibleIfAny}}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                Visibility="{Binding HasNoRoots, Converter={StaticResource VisibleIfAny}}">
                        <TextBlock Text="Папки со скриптами не заданы" Foreground="#666" HorizontalAlignment="Center" />
                        <Button Content="Добавить в настройках" Command="{Binding OpenSettingsCommand}"
                                Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <ContentControl Content="{Binding SelectedScript}" />
                <TextBlock Text="Выберите скрипт" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedScript, Converter={StaticResource VisibleIfNone}}" />
            </Grid>

            <!-- Запуск завершился, а его результат не на экране: сообщение в углу, «Открыть» — к результату. -->
            <Border Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" MaxWidth="460"
                    Background="#FFFDE7" BorderBrush="#F9A825" BorderThickness="1" CornerRadius="4" Padding="10,8"
                    Visibility="{Binding ToastRun, Converter={StaticResource VisibleIfAny}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource RunDot}" Tag="{Binding ToastRun.State}" FontSize="16" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Padding="4" Margin="8,0,0,0"
                            VerticalAlignment="Top" Command="{Binding CloseToastCommand}" ToolTip="Закрыть" />
                    <Button DockPanel.Dock="Right" Content="Открыть" Command="{Binding OpenToastCommand}" Margin="10,0,0,0"
                            VerticalAlignment="Center" FontWeight="SemiBold" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToastText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ToastRun.Details}" Foreground="#666" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
