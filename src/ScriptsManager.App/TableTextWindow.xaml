<Window x:Class="ScriptsManager.App.TableTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="900" Height="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Копировать" Command="{Binding CopyCommand}" MinWidth="100" Margin="0" />
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" DisplayMemberPath="Name" MinWidth="180" />
                <CheckBox Content="Только выделенное" IsChecked="{Binding OnlySelection}" IsEnabled="{Binding HasSelection}"
                          VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </DockPanel>
        <TextBox x:Name="TextBox" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
