<Application x:Class="ScriptsManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ScriptsManager.App.Infrastructure"
             xmlns:md="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <infra:EmptyToCollapsedConverter x:Key="VisibleIfAny" />
        <infra:EmptyToCollapsedConverter x:Key="VisibleIfNone" Invert="True" />
        <infra:NotConverter x:Key="Not" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Плашка тега: в фильтре главного окна и в окне правки. -->
        <Style x:Key="TagToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" CornerRadius="10" Padding="8,1,8,2" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="1">
                            <ContentPresenter x:Name="Text" TextElement.Foreground="#455A64" TextElement.FontSize="11" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#90A4AE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#5C6BC0" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#5C6BC0" />
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовки подробного описания (markdown): по умолчанию у Markdig.Wpf они слишком крупные. -->
        <Style x:Key="{x:Static md:Styles.Heading1StyleKey}" TargetType="Paragraph">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="{x:Static md:Styles.Heading2StyleKey}" TargetType="Paragraph">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style x:Key="{x:Static md:Styles.Heading3StyleKey}" TargetType="Paragraph">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Application.Resources>
</Application>
