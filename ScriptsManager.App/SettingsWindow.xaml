<Window x:Class="ScriptsManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="460" Width="760" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" IsDefault="True" Click="Ok_Click" MinWidth="90" />
            <Button Content="Отмена" IsCancel="True" MinWidth="90" Margin="0" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Python:" VerticalAlignment="Center" Margin="0,0,8,4" />
            <TextBox Grid.Column="1" Text="{Binding PythonPath}" Margin="0,0,0,4" Padding="3,2"
                     ToolTip="Путь к python.exe; пусто — python из PATH" />
            <TextBlock Grid.Row="1" Text="PowerShell:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PowerShellPath}" Padding="3,2"
                     ToolTip="Путь к powershell.exe или pwsh.exe; пусто — Windows PowerShell" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="Папки со скриптами" FontWeight="SemiBold" Margin="0,0,0,6" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Добавить…" Command="{Binding AddRootCommand}" />
            <Button Content="Удалить" Command="{Binding RemoveRootCommand}" />
            <Button Content="Выше" Command="{Binding MoveUpCommand}" />
            <Button Content="Ниже" Command="{Binding MoveDownCommand}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                <DataGridTextColumn Header="Путь" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
