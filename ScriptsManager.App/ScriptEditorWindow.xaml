<Window x:Class="ScriptsManager.App.ScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:ScriptsManager.App.Infrastructure"
        xmlns:vm="clr-namespace:ScriptsManager.App.ViewModels"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{Binding WindowTitle}" Height="780" Width="1180" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop">
    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,8,6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Сохранить" IsDefault="True" Click="Save_Click" MinWidth="90" FontWeight="SemiBold" />
                <Button Content="Отмена" IsCancel="True" MinWidth="90" Margin="0" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" />
        </DockPanel>

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Название:" Style="{StaticResource Caption}" />
            <TextBox Grid.Column="1" x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
            <TextBlock Grid.Column="2" Text="Язык:" Style="{StaticResource Caption}" Margin="12,3,8,6" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding Runners}" DisplayMemberPath="Name" SelectedValuePath="Runner"
                      SelectedValue="{Binding Runner}" IsEnabled="{Binding IsNew}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Text="Описание:" Style="{StaticResource Caption}" />
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="80"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Grid.Row="2" Text="Теги:" Style="{StaticResource Caption}" />
            <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6">
                <CheckBox DockPanel.Dock="Right" Content="Лог" IsChecked="{Binding OutputLog}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="Таблицы" IsChecked="{Binding OutputGrid}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="Вывод:" VerticalAlignment="Center" Margin="16,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="Повторный запуск" IsChecked="{Binding Rerun}"
                          ToolTip="Кнопка «Запустить ещё раз» на вкладке «Результат»: новый запуск с теми же параметрами"
                          VerticalAlignment="Center" Margin="12,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="Спрашивать подтверждение перед запуском" IsChecked="{Binding Confirm}"
                          VerticalAlignment="Center" Margin="12,0,0,0" />
                <WrapPanel VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding TagList}" Focusable="False" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,1,3,2" Margin="0,2,4,2" Background="#5C6BC0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="White"
                                                Background="Transparent" BorderThickness="0" Padding="4,2" Margin="2,0,0,0" Cursor="Hand"
                                                ToolTip="Убрать тег"
                                                Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ComboBox x:Name="TagBox" IsEditable="True" Width="170" Margin="0,2,0,2" ItemsSource="{Binding SuggestedTags}"
                              Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" DropDownClosed="TagBox_DropDownClosed"
                              ToolTip="Выберите тег из списка или введите новый и нажмите Enter">
                        <ComboBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddTagCommand}" />
                        </ComboBox.InputBindings>
                    </ComboBox>
                </WrapPanel>
            </DockPanel>

            <TextBlock Grid.Row="3" Text="Куда:" Style="{StaticResource Caption}" />
            <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6"
                       Visibility="{Binding IsLocationEditable, Converter={StaticResource VisibleIfAny}}">
                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Roots}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedRoot}"
                          Width="160" Margin="0,0,6,0" />
                <TextBlock DockPanel.Dock="Left" Text="подпапка" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666" />
                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Folders}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True" Width="260" Margin="0,0,6,0" ToolTip="Можно ввести новую" />
                <TextBlock DockPanel.Dock="Left" Text="файл" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="#666" />
                <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Padding="3,2"
                         ToolTip="{Binding TargetPath}" />
            </DockPanel>
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding TargetPath}" Foreground="#666" Margin="0,3,0,6"
                       TextTrimming="CharacterEllipsis" Visibility="{Binding IsLocationEditable, Converter={StaticResource VisibleIfNone}}" />
        </Grid>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="560" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Left" Content="Из файла…" Command="{Binding BrowseFileCommand}" />
                    <TextBlock Text="или вставьте текст скрипта; файл можно перетащить в окно" Foreground="#888" VerticalAlignment="Center" />
                </DockPanel>
                <Border BorderBrush="#ABADB3" BorderThickness="1">
                    <avalon:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="13" ShowLineNumbers="True"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                       infra:CodeViewer.Syntax="{Binding Syntax}" />
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <TabControl Grid.Column="2">
                <TabItem Header="Параметры">
                    <DockPanel Margin="4">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Найти в скрипте" Command="{Binding AnalyzeCommand}"
                                    ToolTip="T-SQL: DECLARE в начале скрипта; PL/pgSQL: @имя и current_setting('param.имя'); PowerShell: param(); Python: add_argument" />
                            <Button Content="Добавить" Command="{Binding AddParameterCommand}" />
                            <Button Content="Удалить" Command="{Binding RemoveParameterCommand}" />
                            <Button Content="↑" Command="{Binding MoveUpCommand}" Padding="8,3" />
                            <Button Content="↓" Command="{Binding MoveDownCommand}" Padding="8,3" />
                        </StackPanel>

                        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Parameters}" SelectedItem="{Binding SelectedParameter}"
                                 Height="150">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Include}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  ToolTip="Сделать параметром. Без отметки переменная остаётся в скрипте как есть" />
                                        <TextBlock Text="{Binding Caption}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Include}" Value="False">
                                                            <Setter Property="Foreground" Value="#999" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="#B26A00" Margin="6,0,0,0"
                                                   ToolTip="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource VisibleIfAny}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <Grid DataContext="{Binding SelectedParameter}" IsEnabled="{Binding Include}"
                                  Visibility="{Binding Converter={StaticResource VisibleIfAny}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"
                                           Visibility="{Binding Source, Converter={StaticResource VisibleIfAny}}">
                                    <Run Text="В скрипте:" /> <Run Text="{Binding Source, Mode=OneWay}" FontFamily="Consolas" />
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Note}" TextWrapping="Wrap" Foreground="#B26A00" Margin="0,0,0,6"
                                           Visibility="{Binding Note, Converter={StaticResource VisibleIfAny}}" />

                                <TextBlock Grid.Row="2" Text="Имя:" Style="{StaticResource Caption}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                         ToolTip="Как в скрипте: @имя, $имя или --имя" />

                                <TextBlock Grid.Row="3" Text="Приглашение:" Style="{StaticResource Caption}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                         ToolTip="Подпись поля в форме; пусто — имя" />

                                <TextBlock Grid.Row="4" Text="Подсказка:" Style="{StaticResource Caption}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Help, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                         AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Всплывающая подсказка у поля, необязательно" />

                                <TextBlock Grid.Row="5" Text="Тип:" Style="{StaticResource Caption}" />
                                <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,6">
                                    <CheckBox DockPanel.Dock="Right" Content="Обязательный" IsChecked="{Binding Required}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <ComboBox ItemsSource="{x:Static vm:ParameterEditViewModel.Types}" DisplayMemberPath="Name" SelectedValuePath="Type"
                                              SelectedValue="{Binding Type}" />
                                </DockPanel>

                                <TextBlock Grid.Row="6" Text="По умолчанию:" Style="{StaticResource Caption}" />
                                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,6">
                                    <TextBox Text="{Binding DefaultText, UpdateSourceTrigger=PropertyChanged}" Padding="3,2" />
                                    <TextBlock Text="{Binding DefaultHint}" Foreground="#888" FontSize="11" TextWrapping="Wrap"
                                               Visibility="{Binding DefaultHint, Converter={StaticResource VisibleIfAny}}" />
                                </StackPanel>

                                <TextBlock Grid.Row="7" Text="Диапазон:" Style="{StaticResource Caption}"
                                           Visibility="{Binding IsNumber, Converter={StaticResource VisibleIfAny}}" />
                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6"
                                            Visibility="{Binding IsNumber, Converter={StaticResource VisibleIfAny}}">
                                    <TextBlock Text="от" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}" Width="90" Padding="3,2" />
                                    <TextBlock Text="до" VerticalAlignment="Center" Margin="10,0,6,0" />
                                    <TextBox Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}" Width="90" Padding="3,2" />
                                </StackPanel>

                                <CheckBox Grid.Row="7" Grid.Column="1" Content="Многострочное поле" IsChecked="{Binding Multiline}" Margin="0,0,0,6"
                                          Visibility="{Binding IsString, Converter={StaticResource VisibleIfAny}}" />

                                <TextBlock Grid.Row="8" Text="Элементы:" Style="{StaticResource Caption}"
                                           Visibility="{Binding IsList, Converter={StaticResource VisibleIfAny}}" />
                                <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,6"
                                            Visibility="{Binding IsList, Converter={StaticResource VisibleIfAny}}">
                                    <TextBox Text="{Binding ItemsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="90"
                                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="3,2" />
                                    <TextBlock Text="По одному в строке: «значение» или «ключ = подпись» (передаётся ключ)" Foreground="#888" FontSize="11"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox Content="Несколько значений" IsChecked="{Binding Multi}" Margin="0,0,12,0" />
                                        <CheckBox Content="Можно ввести своё значение" IsChecked="{Binding Editable}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="9" Text="Фильтр:" Style="{StaticResource Caption}"
                                           Visibility="{Binding IsFile, Converter={StaticResource VisibleIfAny}}" />
                                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                         ToolTip="Фильтр диалога выбора файла, например CSV|*.csv|Все файлы|*.*"
                                         Visibility="{Binding IsFile, Converter={StaticResource VisibleIfAny}}" />
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Подключения">
                    <DockPanel Margin="4">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Добавить" Command="{Binding AddConnectionCommand}" />
                            <Button Content="Удалить" Command="{Binding RemoveConnectionCommand}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#888" Margin="0,6,0,0"
                                   Text="SQL-скрипт выполняется на первом подключении. PowerShell и Python получают подключение «имя» в переменных окружения DB_ИМЯ_CONNSTR, DB_ИМЯ_SERVER и т.д." />
                        <DataGrid ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridComboBoxColumn Header="СУБД" Width="130" DisplayMemberPath="Name" SelectedValuePath="Kind"
                                                        SelectedValueBinding="{Binding Type}"
                                                        ItemsSource="{x:Static vm:ScriptEditorViewModel.DbKinds}"
                                                        />
                                <DataGridCheckBoxColumn Header="Только сервер" Binding="{Binding ServerOnly, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Описание">
                    <DockPanel Margin="4">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#888" Margin="0,0,0,4"
                                   Text="Подробное описание в markdown — на вкладке «Описание» карточки скрипта. Хранится рядом с манифестом (.manifests/…/Имя.sql.md); пустое — файла нет" />
                        <Border BorderBrush="#ABADB3" BorderThickness="1">
                            <avalon:TextEditor x:Name="DescriptionEditor" FontFamily="Consolas" FontSize="13" WordWrap="True"
                                               VerticalScrollBarVisibility="Auto" infra:CodeViewer.Syntax="MarkDown" />
                        </Border>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
